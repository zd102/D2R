{
  "name": "eclipse-ii",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "node --watch --watch-preserve-output scripts/dev.mjs",
    "dev:local": "vite --host 0.0.0.0",
    "dev:server": "node server/main.ts",
    "backup:online": "node server/backup.ts",
    "build": "node scripts/verify-native-audio.mjs && tsc --noEmit && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:server": "node --test server/tests/*.test.ts",
    "test:online": "node tests/online-browser.mjs",
    "test:online-compat": "node tests/online-compat-browser.mjs",
    "balance:report": "node scripts/balance-report.ts",
    "balance:classes": "node scripts/class-audit.mjs",
    "balance:endgame": "node scripts/endgame-audit.mjs",
    "test:endgame-browser": "node tests/endgame-audit-browser.mjs",
    "balance:class-variants": "node scripts/class-audit-variants.mjs",
    "items:report": "node scripts/item-attribute-report.ts",
    "test:item-skills": "node tests/item-skills-browser.mjs",
    "test:item-effects": "node tests/item-effects-browser.mjs",
    "test:item-special-effects": "node tests/item-special-effects-browser.mjs",
    "test:potions": "node tests/potions-browser.mjs",
    "test:mercenary": "node tests/mercenary-browser.mjs",
    "test:gambling": "node tests/gambling-browser.mjs && node tests/gambling-inventory-browser.mjs",
    "test:nightmare-pressure": "node tests/nightmare-pressure-browser.mjs",
    "test:pandemonium": "node tests/pandemonium-browser.mjs",
    "test:maps": "node tests/maps-chests-browser.mjs",
    "test:camp-return": "node tests/camp-return-browser.mjs",
    "test:map-orientation": "node tests/map-orientation-browser.mjs",
    "test:scenery": "node tests/scenery-browser.mjs",
    "test:performance": "node tests/performance-browser.mjs",
    "test:boss-performance": "node tests/boss-performance-browser.mjs",
    "test:monster-batches": "node tests/monster-batches-browser.mjs",
    "test:campaign-rewards": "node tests/campaign-rewards-browser.mjs",
    "test:story-creation": "node tests/story-creation-browser.mjs",
    "test:player-count": "node tests/player-count-browser.mjs",
    "test:visuals": "node tests/visuals-browser.mjs",
    "test:models": "node tests/models-browser.mjs",
    "test:elites": "node tests/elites-browser.mjs",
    "test:monster-diversity": "node tests/monster-diversity-browser.mjs",
    "test:monster-skills": "node tests/monster-skills-browser.mjs",
    "test:controls": "node tests/pointer-controls-browser.mjs && node tests/navigation-browser.mjs && node tests/combat-input-browser.mjs && node tests/wasd-controls-browser.mjs && node tests/frame-timing-browser.mjs",
    "test:item-art": "node tests/item-art-browser.mjs",
    "test:ranged": "node tests/ranged-browser.mjs",
    "test:classes": "node tests/classes-browser.mjs",
    "test:expansion-classes": "node tests/expansion-classes-browser.mjs",
    "test:modern": "node tests/modern-browser.mjs",
    "test:item-rolls": "node tests/item-rolls-browser.mjs",
    "test:shared-stash": "node tests/shared-stash-browser.mjs && node tests/storage-equipment-browser.mjs && node tests/stash-exchange-browser.mjs",
    "test:ui": "node tests/ui-layout-browser.mjs && node tests/ui-interactions-browser.mjs && node tests/ui-accessibility-browser.mjs && node tests/inventory-details-browser.mjs",
    "test:mobile-ui": "node tests/mobile-ui-browser.mjs",
    "test:inventory-drag": "node tests/inventory-drag-browser.mjs && node tests/drag-exchange-browser.mjs && node tests/equipment-drag-browser.mjs",
    "test:cube": "node tests/cube-browser.mjs",
    "test:runeword-tooltip": "node tests/runeword-tooltip-browser.mjs",
    "test:runeword-crafting": "node tests/runeword-crafting-browser.mjs",
    "test:memory": "node tests/memory-browser.mjs && node tests/audio-memory-browser.mjs",
    "test:audio": "node tests/audio-browser.mjs && node tests/audio-memory-browser.mjs",
    "test:browser": "node tests/profiles-browser.mjs && node tests/character-transfer-browser.mjs && node tests/camp-browser.mjs && node tests/browser-smoke.mjs && node tests/paladin-browser.mjs && npm run test:inventory-drag && node tests/item-economy-browser.mjs && node tests/loot-pickup-browser.mjs && node tests/campaign-browser.mjs && node tests/campaign-portal-browser.mjs && node tests/campaign.mjs && node tests/browser-regressions.mjs && node tests/expansion-browser.mjs && node tests/affixes-browser.mjs && node tests/balance-browser.mjs && node tests/catalog-loot-browser.mjs && node tests/encyclopedia-browser.mjs",
    "package:server": "node scripts/package-server.mjs",
    "test:package": "node tests/server-package-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "cannon-es": "^0.20.0",
    "fastify": "^5.12.4",
    "lucide": "^0.468.0",
    "pathfinding": "^0.4.18",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.4",
    "@types/pathfinding": "^0.0.9",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
